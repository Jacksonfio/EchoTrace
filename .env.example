# ═══════════════════════════════════════════════════════════════
# EchoTrace AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Three-service architecture:
#   Frontend (Next.js) ..... :3000
#   Backend  (Express) ..... :3001
#   Auth     (Python/FastAPI) :8000
# ═══════════════════════════════════════════════════════════════

# ── Express Backend ──────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Gemini AI API (Google AI Studio) ────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Python Auth Service ──────────────────────────────────────
# Shared JWT secret (must match auth-server/.env)
JWT_SECRET=echotrace-dev-secret-change-in-production
AUTH_SERVICE_URL=http://localhost:8000
PYTHON_AUTH_PORT=8000

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH_URL=http://localhost:8000

# ── Firebase (Optional — for production deployment) ─────────
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
